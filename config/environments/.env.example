# =============================================================================
# Environment template. Copy to .env.dev / .env.staging / .env.prod.
# Real secrets belong in `.env.local` (git-ignored) or in CI secrets.
# Any real process env var (e.g. a GitHub Actions secret) always wins over files.
# =============================================================================

# --- Application under test --------------------------------------------------
BASE_URL=https://example.com
API_BASE_URL=https://api.example.com

# --- Credentials -------------------------------------------------------------
# Convention: <ROLE>_USERNAME + <ROLE>_PASSWORD are auto-discovered and exposed
# as config.users.<role> (lower-cased). Add roles by adding variables only.
STANDARD_USERNAME=
STANDARD_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional static API token (skips UI/API login when provided)
API_TOKEN=

# --- Execution ---------------------------------------------------------------
HEADLESS=true
SLOW_MO=0
WORKERS=
RETRIES=
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
TEST_ID_ATTRIBUTE=data-testid
IGNORE_HTTPS_ERRORS=false

# --- Auth session reuse ------------------------------------------------------
AUTH_MAX_AGE_MINUTES=60

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
LOG_TO_FILE=true
