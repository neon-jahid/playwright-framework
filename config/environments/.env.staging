# Staging environment
BASE_URL=https://staging.letsvibebd.com
API_BASE_URL=https://staging.letsvibebd.com/api

# Secrets come from .env.local or CI secrets - never commit them.
STANDARD_USERNAME=
STANDARD_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

HEADLESS=true
RETRIES=1
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
TEST_ID_ATTRIBUTE=data-testid
AUTH_MAX_AGE_MINUTES=30
LOG_LEVEL=info
LOG_TO_FILE=true
