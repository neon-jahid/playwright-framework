# Production environment - keep to read-only / smoke coverage.
BASE_URL=https://letsvibebd.com
API_BASE_URL=https://letsvibebd.com/api

# Secrets come from .env.local or CI secrets - never commit them.
STANDARD_USERNAME=
STANDARD_PASSWORD=

HEADLESS=true
RETRIES=2
TEST_TIMEOUT_MS=90000
EXPECT_TIMEOUT_MS=15000
ACTION_TIMEOUT_MS=20000
NAVIGATION_TIMEOUT_MS=45000
TEST_ID_ATTRIBUTE=data-testid
AUTH_MAX_AGE_MINUTES=15
LOG_LEVEL=warn
LOG_TO_FILE=true
