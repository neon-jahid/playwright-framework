# Development environment
BASE_URL=https://letsvibebd.com
# Demo API used by the example API spec - point this at your own API.
API_BASE_URL=https://jsonplaceholder.typicode.com

# Sign-in accepts a phone number or an email address.
# Fill these in .env.local (git-ignored) - while they are empty the auth setup
# project skips instead of failing, and auth-dependent specs skip with it.
STANDARD_USERNAME=
STANDARD_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

HEADLESS=true
SLOW_MO=0
RETRIES=0
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
TEST_ID_ATTRIBUTE=data-testid
AUTH_MAX_AGE_MINUTES=60
LOG_LEVEL=debug
LOG_TO_FILE=true
