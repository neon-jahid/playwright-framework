{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable, scalable Playwright test automation framework (POM + fixtures + multi-environment)",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui-mode": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:tag": "playwright test --grep",
    "test:file": "playwright test",
    "test:serial": "playwright test --workers=1",
    "test:parallel": "playwright test --workers=4",
    "test:retry": "playwright test --retries=2",
    "test:failed": "playwright test --last-failed",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:smoke:staging": "cross-env TEST_ENV=staging playwright test --grep @smoke",
    "report": "playwright show-report reports/html",
    "report:junit": "node -e \"console.log(require('fs').readFileSync('reports/junit/results.xml','utf8'))\"",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen",
    "auth:refresh": "cross-env FORCE_AUTH_REFRESH=true playwright test --project=setup",
    "clean": "node scripts/clean.js",
    "clean:auth": "node scripts/clean.js --auth",
    "clean:all": "node scripts/clean.js --all",
    "clean:dry": "node scripts/clean.js --dry-run",
    "install:browsers": "playwright install --with-deps",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml}\"",
    "prepare:ci": "npm ci && npx playwright install --with-deps"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "page-object-model",
    "e2e"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^9.4.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-playwright": "^2.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.2"
  }
}
